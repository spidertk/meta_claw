<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    Meta-Claw 聚合父 POM
    作用：统一管理系统中所有子模块的依赖版本、构建配置和插件管理
    包含模块：meta-claw-core、meta-claw-gateway、meta-claw-gateway-weixin、
             meta-claw-bootstrap、meta-claw-store、meta-claw-tool、meta-claw-cli
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目坐标：整个 Meta-Claw 系统的唯一标识 -->
    <groupId>com.meta</groupId>
    <artifactId>meta-claw</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- packaging 为 pom 表示这是一个聚合/父项目，不产生实际构件 -->
    <packaging>pom</packaging>

    <!-- 项目基本信息 -->
    <name>Meta-Claw</name>
    <description>Meta-Claw 多模块聚合项目</description>

    <!-- 聚合的子模块：7 个业务模块 + 1 个第三方本地模块 -->
    <modules>
        <module>third-party/openilink-sdk-java</module>
        <module>meta-claw-core</module>
        <module>meta-claw-gateway</module>
        <module>meta-claw-gateway-weixin</module>
        <module>meta-claw-bootstrap</module>
        <module>meta-claw-store</module>
        <module>meta-claw-tool</module>
        <module>meta-claw-cli</module>
    </modules>

    <!-- 属性配置：统一管理版本号 -->
    <properties>
        <!-- 项目编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Java 版本 -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <java.version>21</java.version>
        <!-- Spring Boot 版本 - Spring AI 1.1.x 维护线要求 Spring Boot 3.5.x -->
        <spring-boot.version>3.5.15</spring-boot.version>
        <!-- Spring AI 版本 - 2026-06-12 发布的 1.1.8 维护版本 -->
        <spring-ai.version>1.1.8</spring-ai.version>
        <!-- Spring AI Alibaba 版本 - 1.1.x 线，与 Spring AI 1.1.x / Spring Boot 3.5.x 兼容 -->
        <spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>
        <!-- Guava 版本 -->
        <guava.version>32.1.3-jre</guava.version>
        <!-- Lombok 版本 -->
        <lombok.version>1.18.30</lombok.version>
        <!-- JLine3 版本 -->
        <jline.version>3.25.1</jline.version>
        <!-- Apache Commons Lang3 版本 -->
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <!-- Eclipse JGit 版本：为 GitTool 提供 Java Git 能力 -->
        <jgit.version>6.10.0.202406032230-r</jgit.version>
    </properties>

    <!-- 依赖版本管理：子模块可引用而不必指定版本 -->
    <dependencyManagement>
        <dependencies>
            <!-- 导入 Spring Boot BOM，统一管理 Spring Boot 生态依赖版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 导入 Spring AI BOM，统一管理 Spring AI 相关依赖版本 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 导入 Spring AI Alibaba BOM，统一管理 Alibaba 工具生态版本 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 内部模块版本管理：meta-claw-core 核心基础模块 -->
            <dependency>
                <groupId>com.meta</groupId>
                <artifactId>meta-claw-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 内部模块版本管理：meta-claw-gateway 通用网关模块 -->
            <dependency>
                <groupId>com.meta</groupId>
                <artifactId>meta-claw-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 内部模块版本管理：meta-claw-gateway-weixin 微信网关模块 -->
            <dependency>
                <groupId>com.meta</groupId>
                <artifactId>meta-claw-gateway-weixin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 内部模块版本管理：meta-claw-bootstrap 系统启动模块 -->
            <dependency>
                <groupId>com.meta</groupId>
                <artifactId>meta-claw-bootstrap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 内部模块版本管理：meta-claw-store 数据存储模块 -->
            <dependency>
                <groupId>com.meta</groupId>
                <artifactId>meta-claw-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 内部模块版本管理：meta-claw-tool 工具引擎模块 -->
            <dependency>
                <groupId>com.meta</groupId>
                <artifactId>meta-claw-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 内部模块版本管理：meta-claw-cli 命令行交互模块 -->
            <dependency>
                <groupId>com.meta</groupId>
                <artifactId>meta-claw-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Guava：Google 开源的 Java 核心工具库 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!-- ByteBuddy：统一版本，避免 Mockito 传递依赖冲突 -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>1.17.8</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>1.17.8</version>
            </dependency>
            <!-- Lombok：通过注解减少样板代码 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!-- JLine3：终端控制库 -->
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline-terminal</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline-reader</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <!-- Apache Commons Lang3：Java 核心工具库 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <!-- OpenILink SDK：微信 iLink 协议 Java SDK（本地子模块） -->
            <dependency>
                <groupId>com.openilink</groupId>
                <artifactId>openilink-sdk-java</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <!-- Eclipse JGit：Java Git 库，供 GitTool 使用 -->
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 构建配置 -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Spring Boot Maven 插件 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- 仓库配置：Spring AI / Spring Boot / Spring AI Alibaba 均已发布至 Maven Central -->
    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

</project>
